<?npl
if(not ABSPATH) then die() end

-- if it is nplide.page, use fullsize in window.
-- also returns true if the content page file contains a PAGE_NO_HEADER marker in its first 512 bytes.
local function is_fullsize()
	local source_path = commonlib.Encoding.DefaultToUtf8(page_path() or __FILE__);
	if(source_path)then
		source_path = string.lower(source_path);
		if(string.find(source_path,"nplide.page"))then
			return true;
		end
	end
	-- Peek at the content file to check for PAGE_NO_HEADER without executing it
	local content_path = page_path();
	if(content_path) then
		local f = ParaIO.open(content_path, "r");
		if(f:IsValid()) then
			local header_bytes = f:GetText(0, 512);
			f:close();
			if(header_bytes and header_bytes:find("PAGE_NO_HEADER")) then
				return true;
			end
		end
	end
end
local PAGE_CONTENT_FULLSIZE = is_fullsize();
?>
<? if(PAGE_CONTENT_FULLSIZE)then
    the_content(); 
else get_header();?>
<div class="container">
  <div class="row">
    <div id="content" class="col-md-8">
      <?npl the_content(); ?>
    </div>
    <div id="sidebar" class="col-md-4">
      <?if(not PAGE_NO_SIDE_BAR) then 
			dynamic_sidebar('propertywindow.page'); 
		else ?>
			<script>
				$(function() {
				if(typeof Page != 'undefined')
					Page.ShowSideBar(false);
				});
			</script>
		<? end ?>
    </div>
  </div>
</div>

<?npl get_footer(); ?>
<? end ?>

